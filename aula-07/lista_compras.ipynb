   "source": [
    "lista = []\n",
    "for produto in [\"arroz\", \"feijão\", \"leite\"]:\n",
    "    lista.append(produto)\n",
    "remover = \"feijão\"\n",
    "if remover in lista:\n",
    "    lista.remove(remover)\n",
    "print(\"Lista de compras:\")\n",
    "for i, produto in enumerate(lista, 1):\n",
    "    print(f\"{i}. {produto}\")"
   ]
  }
