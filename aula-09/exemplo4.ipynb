    "def media(notas):\n",
    "    return sum(notas) / len(notas)\n",
    "\n",
    "def classifica(media_final):\n",
    "    if media_final >= 10:\n",
    "        return \"Aprovado\"\n",
    "    return \"Reprovado\"\n",
    "\n",
    "m = media([14, 9, 16])\n",
    "print(f\"{m:.1f}\")\n",
    "print(classifica(m))"
   ]
  }
