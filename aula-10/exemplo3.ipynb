   "source": [
    "# Compreensão de listas\n",
    "quadrados = [n ** 2 for n in range(1, 6)]\n",
    "print(quadrados)\n",
    "\n",
    "pares = [n for n in range(1, 11) if n % 2 == 0]\n",
    "print(pares)\n",
    "\n",
    "cubos = [n ** 3 for n in range(1, 6)]\n",
    "impares = [n for n in range(1, 11) if n % 2 != 0]\n",
    "print(cubos)\n",
    "print(impares)"
   ]
  }
