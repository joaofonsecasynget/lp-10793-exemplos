   "source": [
    "# Compreensão de dicionários\n",
    "notas = {\"Ana\": 14, \"Bruno\": 9, \"Carla\": 18, \"Duarte\": 6}\n",
    "aprovados = {nome: nota for nome, nota in notas.items() if nota >= 10}\n",
    "reprovados = {nome: nota for nome, nota in notas.items() if nota < 10}\n",
    "print(aprovados)\n",
    "print(reprovados)"
   ]
  }
